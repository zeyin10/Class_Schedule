@startuml component
!theme plain
title Component Diagram (draft) — Class Schedule Management System
skinparam componentStyle rectangle

package "Frontend — React + TypeScript (SPA)" as FE {
  [Auth UI] as fe_auth
  [Schedule Views\n(group / teacher / room,\nday / week)] as fe_views
  [Search & Filters] as fe_search
  [Admin Editor\n(entries + conflict feedback)] as fe_admin
  [Reference Data Management] as fe_ref
  [API Client\n(generated from OpenAPI,\nTanStack Query)] as fe_api
}

package "Backend — FastAPI (Python)" as BE {
  [REST API Layer\n(routers, Pydantic schemas,\nOpenAPI)] as be_api
  [Auth & RBAC\n(JWT, roles)] as be_auth
  [Reference Data Service] as be_ref
  [Schedule Service] as be_sched
  [Conflict Checker\n(pre-check + DB constraint\nerror mapping)] as be_conf
  [Audit Log Service] as be_audit
  [Export Service (iCal)] as be_ical
  [Import Service (CSV/Excel)] as be_import
  [Suggestion Engine\n(stretch: OR-Tools)] as be_sugg #EEEEEE
  [Data Access Layer\n(SQLAlchemy, Alembic)] as be_dal
}

database "PostgreSQL 16\n(range types,\nEXCLUDE constraints)" as db
cloud "SMTP\n(optional)" as smtp

fe_auth --> fe_api
fe_views --> fe_api
fe_search --> fe_api
fe_admin --> fe_api
fe_ref --> fe_api
fe_api --> be_api : HTTPS / JSON (REST)

be_api --> be_auth
be_api --> be_ref
be_api --> be_sched
be_api --> be_ical
be_api --> be_import
be_sched --> be_conf
be_sched --> be_audit
be_sched ..> be_sugg
be_import --> be_conf
be_ref --> be_dal
be_sched --> be_dal
be_conf --> be_dal
be_audit --> be_dal
be_ical --> be_dal
be_auth --> be_dal
be_dal --> db : SQL
be_audit ..> smtp : notifications
@enduml
